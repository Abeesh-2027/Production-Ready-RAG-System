# URL of the FastAPI backend (no trailing slash).
# Local:      http://localhost:8000
# Production: your Render URL, e.g. https://rag-chatbot-api.onrender.com
# NOTE: Vite bakes VITE_* values in at build time. Never put secrets here -
# anything in a VITE_ variable is visible to every visitor.
VITE_API_URL=http://localhost:8000
VITE_MAX_UPLOAD_MB=15
