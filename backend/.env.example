# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# --- OpenRouter (LLM + embeddings). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
# Embedding model. The SAME model is used for documents and queries.
# If you change it, delete backend/data/chroma and re-upload your documents
# (vectors from different models are not comparable).
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_BATCH_SIZE=64

# --- Storage
CHROMA_PATH=./data/chroma
UPLOAD_PATH=./data/uploads
COLLECTION_NAME=documents

# --- Chunking (measured in words)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval
TOP_K=10
FINAL_K=5
# RERANKER: lexical (default, no extra deps) | cross_encoder (needs sentence-transformers) | none
RERANKER=lexical
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Chunks scoring below this after reranking are dropped (0-1 scale)
MIN_RELEVANCE=0.15
# Chunks more similar than this (Jaccard on word sets) are treated as duplicates
DUPLICATE_THRESHOLD=0.85
# Maximum characters of retrieved context sent to the LLM
MAX_CONTEXT_CHARS=12000

# --- Generation
TEMPERATURE=0.2
MAX_TOKENS=1000
REQUEST_TIMEOUT_SECONDS=60

# --- Conversation
ENABLE_QUERY_REWRITE=true
MAX_HISTORY_TURNS=6

# --- Uploads
MAX_UPLOAD_MB=15

# --- CORS: comma-separated list of allowed frontend origins (your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex, e.g. to allow Vercel preview deployments:
CORS_ORIGIN_REGEX=
